# ============================================================
# .gitignore — КОМПАС ПО ЖИЗНИ v3.0
# ============================================================
# Игнорируемые файлы и папки для проекта
# ============================================================

# ===== ЛОГИ =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.log
log.txt

# ===== ДИАГНОСТИКА =====
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ===== RUNTIME DATA =====
pids/
*.pid
*.seed
*.pid.lock

# ===== КЭШ =====
.cache/
.parcel-cache/
.vite/
*.tsbuildinfo
.eslintcache
.stylelintcache
.tern-port
.nyc_output/
.grunt/
*.lcov
coverage/

# ===== ЗАВИСИМОСТИ =====
node_modules/
jspm_packages/
web_modules/
.pnpm-store/
.yarn-integrity
.pnp.*
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
bower_components/
vendor/

# ===== БИЛДЫ =====
build/
dist/
.out/
.next/
.nuxt/
.output/
.vuepress/dist/
**/.vitepress/dist
**/.vitepress/cache
.docusaurus/
.serverless/
.fusebox/
.dynamodb/
.svelte-kit/
.publish/
*.tgz
*.tar.gz
*.zip

# ===== СРЕДА =====
.env
.env.*
!.env.example
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ===== IDE / РЕДАКТОРЫ =====
.idea/
.vscode/
*.swp
*.swo
*~
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
.idea/workspace.xml
.idea/tasks.xml
.idea/dictionaries/
.idea/libraries/
.idea/httpRequests/
.classpath
.project
.settings/
*.iml
*.ipr
*.iws

# ===== ОС =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp

# ===== ПРОЕКТ-СПЕЦИФИЧНЫЕ =====

# Локальные данные пользователя
compass_user_data/
*.local.json
*.user.json

# Скриншоты и медиа (кроме нужных в репозитории)
assets/screenshots/*.png
assets/screenshots/*.jpg
assets/screenshots/*.jpeg
!assets/screenshots/placeholder.png

# Пользовательские данные (локальные)
*.db
*.sqlite
*.sqlite3
*.db-journal

# Бэкапы
*.bak
*.backup
*.old
*.orig

# Временные файлы
tmp/
temp/
*.tmp
*.temp

# Конфиги с секретами
config.local.js
config.local.json
*.secret.js
*.secret.json

# Отчёты тестов
test-results/
test-reports/
junit.xml

# Профайлинг
*.prof
*.heapsnapshot
*.cpuprofile

# ===== ДОПОЛНИТЕЛЬНО =====

# Авто-генерируемые файлы
*.min.js
*.min.css
*.bundle.js
*.chunk.js
*.map
*.d.ts

# Сборщики
webpack-stats.json
stats.json
manifest.json.*
asset-manifest.json

# Yarn v3
.yarn/install-state.gz

# Turborepo
.turbo

# Vercel
.vercel
vercel.json

# Netlify
.netlify

# Cloudflare
.cloudflare

# ===== НЕ ИГНОРИРОВАТЬ =====
# Важно! Эти файлы должны быть в репозитории
!/.env.example
!/assets/screenshots/placeholder.png
!/manifest.json
!/sw.js

# ============================================================
# КОНЕЦ .gitignore
# ============================================================
